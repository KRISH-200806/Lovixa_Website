# ========================================================
# 🚀 FLEXION E-COMMERCE STARTER KIT ENVIRONMENT CONFIG
# ========================================================

# --------------------------------------------------------
# 1. CORE NEXT.JS & PAYLOAD CMS SECRETS
# --------------------------------------------------------
PORT=3001
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Generate 32-byte hex: openssl rand -hex 32
PAYLOAD_SECRET=your_super_secret_payload_encryption_key_here
REVALIDATE_SECRET=your_super_secret_revalidate_token_here
SETUP_SECRET=your_super_secret_setup_diagnostics_token_here

# --------------------------------------------------------
# 1.1 ADMIN PANEL CREDENTIALS (Dynamic Configuration)
# --------------------------------------------------------
ADMIN_EMAIL=admin@lovixa.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME="LOVIXA Store Administrator"

# --------------------------------------------------------
# 2. DATABASE CONFIGURATION (Choose MongoDB OR Postgres)
# --------------------------------------------------------
# --- OPTION A: PostgreSQL (Default) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_store

# --- OPTION B: MongoDB (Active if selected) ---
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce_store?retryWrites=true&w=majority

# --------------------------------------------------------
# 3. PAYMENT GATEWAYS (Stripe & Razorpay)
# --------------------------------------------------------
# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay Configuration (Optional)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --------------------------------------------------------
# 4. MEDIA STORAGE (Cloudflare R2 Object Storage)
# --------------------------------------------------------
# Instructions to setup Cloudflare R2:
# 1. Cloudflare Dashboard -> R2 -> Create Bucket (e.g. lovixa-media).
# 2. Copy "Account ID" from right sidebar.
# 3. Click "Manage R2 API Tokens" -> "Create API Token" with Object Read & Write permission.
# 4. Connect a Custom Domain (e.g. media.lovixacosmetic.com) or enable Public Bucket Access (pub-*.r2.dev).
R2_BUCKET=lovixa-media
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_PUBLIC_URL=https://media.lovixacosmetic.com
R2_REGION=auto

# S3 Compatibility Aliases (Optional fallback if using S3_* env conventions)
S3_BUCKET=lovixa-media
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_REGION=auto
S3_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://media.lovixacosmetic.com

# --------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend or SMTP)
# --------------------------------------------------------
EMAIL_FROM_ADDRESS=orders@flexion.dev
EMAIL_FROM_NAME="Flexion Store"
# Option A: Resend (Default)
RESEND_API_KEY=re_...
# Option B: SMTP (Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --------------------------------------------------------
# 6. STORE DEFAULTS & CURRENCY
# --------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=999
NEXT_PUBLIC_SHIPPING_FLAT_RATE=99
NEXT_PUBLIC_DEFAULT_TAX_RATE=18.0
NEXT_PUBLIC_WHATSAPP_NUMBER=919712460509
