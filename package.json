{
  "name": "flexion-ecommerce-store",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "seed:ecommerce": "tsx scripts/seed-ecommerce.ts",
    "seed:catalog": "tsx scripts/seed-lovixa-catalog.ts",
    "seed:pages": "tsx scripts/seed-pages.ts",
    "sync:admin": "tsx scripts/sync-admin.ts",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "generate:types": "payload generate:types",
    "generate:schema": "payload generate:schema",
    "generate:importmap": "payload generate:importmap",
    "backup": "tsx scripts/backup-restore.ts --backup",
    "restore": "tsx scripts/backup-restore.ts --restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.614.0",
    "@isdisposable/js": "^1.0.7",
    "@payloadcms/db-mongodb": "3.24.0",
    "@payloadcms/db-postgres": "3.24.0",
    "@payloadcms/next": "3.24.0",
    "@payloadcms/plugin-redirects": "3.24.0",
    "@payloadcms/plugin-seo": "3.24.0",
    "@payloadcms/plugin-stripe": "3.24.0",
    "@payloadcms/richtext-lexical": "3.24.0",
    "@payloadcms/storage-s3": "3.24.0",
    "@payloadcms/storage-azure": "3.24.0",
    "@payloadcms/storage-gcs": "3.24.0",
    "@payloadcms/storage-vercel-blob": "3.24.0",
    "@payloadcms/storage-uploadthing": "3.24.0",
    "@payloadcms/ui": "3.24.0",
    "@react-pdf/renderer": "^4.2.2",
    "@sentry/nextjs": "^8.55.0",
    "clsx": "^2.1.1",
    "docx": "^9.2.1",
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.1",
    "graphql": "^16.10.0",
    "lucide-react": "^1.16.0",
    "next": "15.5.28",
    "nodemailer": "^6.10.0",
    "payload": "3.24.0",
    "razorpay": "^2.9.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.1.2",
    "sharp": "^0.33.5",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
